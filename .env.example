# 비워 두면 데모 응답으로 실행합니다(서버 없이 화면만 확인).
# 서버 API로 연결하려면 .env(또는 .env.local)에 아래 값을 채웁니다. 경로 /api/v1은 자동으로 붙습니다.
# Android 에뮬레이터에서 내 PC의 서버는 http://10.0.2.2:<포트>, 실기기는 PC의 IP나 HTTPS 주소를 씁니다.
EXPO_PUBLIC_API_BASE_URL=

# 카카오 SDK 연결 전 개발용 카카오 액세스 토큰. 목 서버(npm run mock:api)는 mock-kakao-<아무값>을 받습니다.
# 실제 카카오 토큰은 커밋하지 않습니다. EXPO_PUBLIC_ 값은 앱 번들에 포함되므로 비밀 키를 넣지 않습니다.
EXPO_PUBLIC_KAKAO_ACCESS_TOKEN=

# 약관 버전(서버 AUTH_*_VERSIONS와 같아야 함). 비우면 2026-11-06-v1.
EXPO_PUBLIC_AGREEMENT_VERSION=
