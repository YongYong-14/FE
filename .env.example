# 서버 주소는 필수입니다. /api/v1은 없을 때만 붙습니다.
EXPO_PUBLIC_API_BASE_URL=https://54-116-235-74.sslip.io/api/v1

# 프로젝트 카카오 앱의 네이티브 앱 키. 사용자 액세스 토큰이 아닙니다.
# 패키지명과 서명 키 해시를 콘솔에 등록하고 키 변경 후 Android를 다시 빌드합니다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# 지도·위치 검색(상호·건물명·주소)에 쓰는 카카오 REST API 키. 비우면 Android 주소 검색을 씁니다.
# 앱 번들에 포함되므로 콘솔에서 호출 허용 범위를 제한해 두세요.
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# 백엔드의 약관 버전. 비우면 2026-11-06-v1을 사용합니다.
EXPO_PUBLIC_AGREEMENT_VERSION=

# 웹/카카오 지도 모듈이 없는 빌드의 실제 지도 타일 URL. 비우면 OpenStreetMap.
EXPO_PUBLIC_MAP_TILE_URL=
